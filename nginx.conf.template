events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    
    # Increase maximum upload limit for PDF resumes
    client_max_body_size 50M;

    server {
        listen 80;

        # Swipe Match Service
        location /api/v1/swipes {
            proxy_pass http://${SWIPE_MATCH_HOST}:8080/api/v1/swipes;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /api/v1/matches {
            proxy_pass http://${SWIPE_MATCH_HOST}:8080/api/v1/matches;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # User Job Service (Everything else under /api/)
        location /api/ {
            proxy_pass http://${USER_JOB_HOST}:8081/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Cover Letter AI Service
        location /api/generate-cover-letter {
            proxy_pass http://${COVER_LETTER_HOST}:8000/generate-cover-letter;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Healthcheck endpoint
        location /health {
            return 200 'healthy\n';
        }
    }
}
