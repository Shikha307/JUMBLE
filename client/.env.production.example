# ============================================================
# PRODUCTION — AWS endpoints (injected by GitHub Actions CI/CD)
# ============================================================
# Add VITE_* vars as GitHub Secrets.
# They are injected at npm run build time by the CI/CD workflow.

VITE_SWIPE_API_URL=http://<EC2-PUBLIC-IP>
VITE_USER_JOB_API_URL=http://<EC2-PUBLIC-IP>
VITE_ML_OUTPUTS_URL=https://jumble-ml-outputs.s3.<REGION>.amazonaws.com
